# ---- LLM (any OpenAI-compatible chat-completions endpoint with function calling) ----
# Option A (free tier, fast):  Groq  -> https://console.groq.com/keys
LLM_API_KEY=paste_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Option C: Google Gemini (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Option D: fully local with Ollama (no internet / no key needed)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Dev/testing only: rule-based stand-in that is NOT an LLM (lets you click through the UI with no key)
# LLM_PROVIDER=mock

# ---- Agent limits (guardrails) ----
# ---- RAG (semantic chunking with overlap) ----
# RAG_CHUNKING=semantic            # semantic | heading (heading = old one-chunk-per-section baseline)
# RAG_OVERLAP_SENTENCES=1
# RAG_BREAKPOINT_PERCENTILE=70
# RAG_EMBEDDER=tfidf               # tfidf (offline) | sbert (pip install sentence-transformers)

MAX_AGENT_STEPS=6
MAX_TOTAL_TOOL_CALLS=8
ENABLE_WEB_SEARCH=true
PORT=8000
